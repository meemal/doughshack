{
  "name": "thedoughshack-theme",
  "private": true,
  "scripts": {
    "build": "sass sass/style.scss style.css --load-path=sass --no-source-map --quiet",
    "build:verbose": "sass sass/style.scss style.css --load-path=sass --no-source-map",
    "watch": "sass sass/style.scss style.css --load-path=sass --watch --embed-source-map --quiet",
    "bump-version": "node scripts/bump-version.mjs",
    "dist": "npm run build && node scripts/package-dist.mjs",
    "dist:zip": "npm run dist && cd dist && zip -r ../thedoughshack-theme-upload.zip thedoughshack",
    "publish": "node scripts/bump-version.mjs && npm run dist:zip"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
